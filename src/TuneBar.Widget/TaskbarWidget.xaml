<Window x:Class="TuneBar.TaskbarWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TuneBar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="Width"
        Height="48">
    <Grid x:Name="Root" Background="#01000000" Visibility="Collapsed">
        <StackPanel x:Name="Layout" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
            <Button x:Name="PreviousButton"
                    Style="{StaticResource IconButton}"
                    Content="&#xE892;"
                    ToolTip="Предыдущий трек"
                    Click="OnPreviousClick" />

            <Border x:Name="CoverHost"
                    Width="34"
                    Height="34"
                    Margin="4,0"
                    CornerRadius="4"
                    Background="{DynamicResource WidgetHover}"
                    Cursor="Hand"
                    MouseLeftButtonUp="OnCoverClick">
                <Grid>
                    <TextBlock x:Name="CoverPlaceholder"
                               Text="&#xE8D6;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="14"
                               Foreground="{DynamicResource WidgetSecondaryForeground}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <Border x:Name="CoverImage" CornerRadius="4" />
                    <Border CornerRadius="4" Background="#80000000">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=CoverHost}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock x:Name="PlayPauseIcon"
                                   Text="&#xE768;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="12"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <Button x:Name="NextButton"
                    Style="{StaticResource IconButton}"
                    Content="&#xE893;"
                    ToolTip="Следующий трек"
                    Click="OnNextClick" />

            <StackPanel x:Name="TrackTextPanel" VerticalAlignment="Center" Margin="6,0,4,0" MaxWidth="180">
                <TextBlock x:Name="TitleText"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource WidgetForeground}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ArtistText"
                           FontSize="11"
                           Foreground="{DynamicResource WidgetSecondaryForeground}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
